# Copy to frontend/.env.local and adjust. .env.local is gitignored; this is not.

# REQUIRED. Origin of the Express backend, read server-side by the route
# handlers in src/app/api. Not NEXT_PUBLIC_: the browser calls this app's own
# origin and the route handlers forward the request, so the backend host never
# reaches the client bundle and no cross-origin request is ever made.
#
# On Cloud Run this is the backend service URL, set on the frontend service.
BACKEND_URL=http://localhost:8080
