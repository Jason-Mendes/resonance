# Copy to backend/.env and fill in. backend/.env is gitignored; this file is not.
#
# There is no API key here. The organisation policy on the hackathon project
# disallows API keys, so everything Google authenticates through Application
# Default Credentials instead:
#
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project nzz-sbx-hckthn08
#
# Check which account ADC is actually using, since it is separate from the one
# `gcloud auth login` uses and they drift apart easily:
#
#   TOKEN=$(gcloud auth application-default print-access-token)
#   curl -s -X POST https://oauth2.googleapis.com/tokeninfo -d "access_token=$TOKEN"
#
# On Cloud Run none of that applies: the service account is used automatically.

# REQUIRED. Google Cloud project that owns the Vertex AI and Cloud TTS quota.
VERTEX_PROJECT=nzz-sbx-hckthn08

# Optional. Defaults to us-central1, which has the widest Vertex model
# availability. Revisit if article content has EU data residency requirements.
VERTEX_LOCATION=us-central1

# REQUIRED. Comma-separated origins allowed to call this API. Anything not
# listed is refused by CORS. Include the deployed frontend and, for local work,
# whatever port the dev server uses.
FRONTEND_ORIGIN=http://localhost:3000

# Optional. Defaults to 8080. Cloud Run sets this itself, so leave it unset there.
PORT=8080
