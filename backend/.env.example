# Copy to backend/.env and fill in. backend/.env is gitignored; this file is not.
# The server throws at startup if either required variable is missing, so a
# misconfigured deploy fails immediately instead of on the first request.

# REQUIRED. Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# REQUIRED. Comma-separated origins allowed to call this API. Anything not
# listed is refused by CORS. Include the deployed frontend and, for local work,
# whatever port the dev server uses.
FRONTEND_ORIGIN=http://localhost:5173

# Optional. Defaults to 8080. Cloud Run sets this itself, so leave it unset there.
PORT=8080
